<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_installment_general" model="ir.ui.view">
        <field name="name">product.template.form.inherit.installment.general</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Downpayment &amp; Surcharge Configuration" name="downpayment_config_general">
                    <field name="x_is_downpayment_enabled" 
                           string="Enable Downpayment Plan" 
                           widget="boolean_toggle"
                           class="oe_inline"/>
                    
                    <group invisible="not x_is_downpayment_enabled">
                        <label for="x_downpayment_percent" string="Downpayment Percent"/>
                        <div class="o_row">
                            <field name="x_downpayment_percent" class="oe_inline"/>
                            <span class="oe_grey">%</span>
                        </div>
                        
                        <label for="x_surcharge_percent" string="Surcharge (Fee) Percent"/>
                        <div class="o_row">
                            <field name="x_surcharge_percent" class="oe_inline"/>
                            <span class="oe_grey">%</span>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
