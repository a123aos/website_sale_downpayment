<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="cart_summary_content_hide_zero_qty" inherit_id="website_sale.cart_summary_content" name="Hide Zero Qty Lines">
            <xpath expr="//tr[@t-foreach='website_sale_order.website_order_line']" position="attributes">
                <attribute name="t-if">line.product_uom_qty &gt; 0</attribute>
            </xpath>
        </template>

        <template id="payment_plan_options_inherit" inherit_id="website_sale.payment" name="Payment Plan Selector">
            <xpath expr="//*[@id='oe_structure_website_sale_payment_1']" position="after">
                <t t-set="installment_lines" t-value="website_sale_order.order_line.filtered(lambda l: l.product_id.x_is_downpayment_enabled)"/>
                
                <t t-if="website_sale_order and installment_lines">
                    <t t-set="is_split" t-value="website_sale_order.x_payment_plan == 'split'"/>

                    <div class="js_payment_plan_selector mb-4">
                        <h4 class="mb-3">Payment plans</h4>
                        <t t-set="dp_prod" t-value="installment_lines[0].product_id"/>
                        
                        <div class="d-none js_plan_config" 
                             t-att-data-dp_rate="dp_prod.x_downpayment_percent"
                             t-att-data-sc_rate="dp_prod.x_surcharge_percent"/>

                        <div class="card border-0 shadow-sm">
                            <div class="list-group">
                                <label class="list-group-item d-flex align-items-center py-3 clickable">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="pay_mode" value="full" id="pay_mode_full" 
                                               t-att-checked="None if is_split else 'checked'"/>
                                    </div>
                                    <div class="ms-2">
                                        <h6 class="mb-0 fw-bold">Prepayment</h6>
                                        <div class="text-muted small">Full advance payment</div>
                                    </div>
                                </label>

                                <label class="list-group-item d-flex align-items-center py-3 clickable">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="pay_mode" value="split" id="pay_mode_split"
                                               t-att-checked="'checked' if is_split else None"/>
                                    </div>
                                    <div class="ms-2">
                                        <h6 class="mb-0 fw-bold">Installment</h6>
                                        <div class="text-muted small">
                                            Initial payment: <t t-esc="dp_prod.x_downpayment_percent"/>% Deposit 
                                            &amp; <t t-esc="dp_prod.x_surcharge_percent"/>% Service fee.
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>

        <template id="installment_fee_total_inherit" inherit_id="website_sale.total" name="Installment Fee Total Display">
            
            <xpath expr="//tr[@name='o_order_total']" position="before">
                <tr t-if="website_sale_order.x_payment_plan == 'split' and website_sale_order.x_installment_fee > 0 and website_sale_order.state in ['draft', 'sent']">
                    <td colspan="2" class="border-0 p-0 pe-3 pb-2 text-muted">
                        Installment Service Fee
                    </td>
                    <td class="text-end border-0 p-0 ps-3 pb-2 text-muted">
                        <span class="monetary_field" style="white-space: nowrap;"
                              t-field="website_sale_order.x_installment_fee" 
                              t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                    </td>
                </tr>
            </xpath>

            <xpath expr="//tr[@name='o_order_total']" position="after">
                <t t-if="website_sale_order.x_payment_plan == 'split'">
                    
                    <tr style="height: 1.2rem;"><td colspan="3" class="border-0"></td></tr>

                    <t t-if="website_sale_order.amount_paid == 0">
                        <tr class="border-top">
                            <td colspan="2" class="border-0 p-0 pe-3 pt-2 pb-1">
                                <strong class="text-primary">Amount to Pay Now</strong>
                            </td>
                            <td class="text-end border-0 p-0 ps-3 pt-2 pb-1">
                                <strong class="text-primary monetary_field" style="white-space: nowrap;"
                                        t-field="website_sale_order.x_amount_to_pay" 
                                        t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-0">
                            <td colspan="2" class="border-0 p-0 pe-3 pb-2 text-muted">
                                <span>Final Payment</span>
                            </td>
                            <td class="text-end border-0 p-0 ps-3 pb-2 text-muted">
                                <t t-set="final_val" t-value="website_sale_order.amount_total - website_sale_order.x_amount_to_pay"/>
                                <span class="monetary_field" style="white-space: nowrap;"
                                      t-esc="final_val" 
                                      t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                            </td>
                        </tr>
                    </t>

                    <t t-if="website_sale_order.amount_paid > 0">
                        <tr class="border-top">
                            <td colspan="2" class="border-0 p-0 pe-3 pt-2 pb-1">
                                <strong class="text-success">Paid</strong>
                            </td>
                            <td class="text-end border-0 p-0 ps-3 pt-2 pb-1">
                                <strong class="text-success monetary_field" style="white-space: nowrap;"
                                        t-field="website_sale_order.amount_paid" 
                                        t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="border-0" t-if="website_sale_order.x_outstanding_balance > 0">
                            <td colspan="2" class="border-0 p-0 pe-3 pb-2 text-danger">
                                <span>Balance Due</span>
                            </td>
                            <td class="text-end border-0 p-0 ps-3 pb-2 text-danger">
                                <span class="monetary_field" style="white-space: nowrap;"
                                      t-field="website_sale_order.x_outstanding_balance" 
                                      t-options='{"widget": "monetary", "display_currency": website_sale_order.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </t>
            </xpath>
        </template>

        <template id="payment_confirmation_status_split_fix" inherit_id="website_sale.payment_confirmation_status">
            <xpath expr="//div[@role='alert']" position="attributes">
                <attribute name="t-attf-class">
                    alert px-3 pb-0 pt-3 #{
                        (tx_sudo.state == 'pending' and 'alert-info') or
                        (tx_sudo.state == 'done' and (order.amount_total == tx_sudo.amount or order.x_payment_plan == 'split') and 'alert-success') or
                        (tx_sudo.state == 'done' and order.amount_total != tx_sudo.amount and order.x_payment_plan != 'split' and 'alert-warning') or
                        (tx_sudo.state == 'authorized' and 'alert-success') or
                        'alert-danger'
                    }
                </attribute>
            </xpath>

            <xpath expr="//t[@t-if=&quot;tx_sudo.state == 'done' and order.amount_total != tx_sudo.amount&quot;]" position="replace">
                <t t-if="tx_sudo.state == 'done' and order.amount_total != tx_sudo.amount and order.x_payment_plan != 'split'">
                    <span>Unfortunately your order can not be confirmed as the amount of your payment does not match the amount of your cart.
                    Please contact the responsible of the shop for more information.</span>
                </t>
                <t t-elif="tx_sudo.state == 'done' and order.x_payment_plan == 'split'">
                    <span>Your deposit has been received successfully. The remaining balance will be processed according to your payment plan.</span>
                </t>
            </xpath>
        </template>

    </data>
</odoo>